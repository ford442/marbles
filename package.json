{
  "name": "marbles",
  "version": "1.0.0",
  "description": "A marble roller for web using Google Filament, Rapier.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:wasm && vite build",
    "preview": "vite preview",
    "build:wasm": "bash wasm/build.sh",
    "build:wasm:debug": "bash wasm/build.sh --debug",
    "check:wasm": "node scripts/check-wasm-artifacts.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "test:levels": "node --experimental-strip-types --no-warnings tests/levels/test_manifest_levels.js && node --experimental-strip-types --no-warnings tests/levels/test_dev_levels.js",
    "test:wasm:parity": "node tests/test_wasm_bridge_wasm.js",
    "bench:wasm:batch": "node tests/benchmark_wasm_batch_simd.mjs",
    "relay": "node server/relay.mjs",
    "dev:party": "node server/relay.mjs & vite",
    "validate:assets": "node scripts/sync-zone-handlers.cjs --check && node scripts/validate-assets.cjs",
    "gen:marbles": "node scripts/generate-marbles-data.mjs",
    "test": "npm run test:unit",
    "test:unit": "node scripts/check-wasm-artifacts.mjs && node tests/test_wasm_bridge_wasm.js && node scripts/run-unit-tests.mjs",
    "test:e2e": "node tests/e2e/test_missile.cjs",
    "test:e2e:smoke": "node tests/e2e/smoke.cjs",
    "test:e2e:smoke:worker": "PHYSICS_WORKER=1 node tests/e2e/smoke.cjs",
    "test:e2e:smoke:main": "PHYSICS_WORKER=0 node tests/e2e/smoke.cjs",
    "lint": "eslint src tests scripts --ext .js,.cjs,.mjs,.ts --ignore-pattern tests/e2e --quiet",
    "typecheck": "tsc --noEmit",
    "level:lab": "node --experimental-strip-types --no-warnings scripts/level-lab.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@webgpu/types": "^0.1.74",
    "ajv": "^8.20.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.1",
    "jsdom": "^28.1.0",
    "playwright": "^1.59.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^6.0.2",
    "vite": "^7.3.1",
    "ws": "^8.21.0"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.13.0",
    "filament": "^1.51.5"
  }
}
