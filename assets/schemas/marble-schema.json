{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Marble Definition Schema",
  "description": "Schema for defining custom marbles",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "appearance",
    "physics"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the marble",
      "pattern": "^[a-z0-9_]+$"
    },
    "name": {
      "type": "string",
      "description": "Display name for the marble"
    },
    "description": {
      "type": "string",
      "description": "Brief description of the marble"
    },
    "version": {
      "type": "string",
      "description": "Semantic version",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "author": {
      "type": "string",
      "description": "Author name or identifier"
    },
    "rarity": {
      "type": "string",
      "enum": [
        "common",
        "uncommon",
        "rare",
        "epic",
        "legendary"
      ],
      "description": "Rarity classification"
    },
    "premium": {
      "type": "boolean",
      "description": "Premium marble: never free; selectable only once granted (its id is in the player's unlockedMarbles). Implies unlock \"premium\"."
    },
    "unlock": {
      "type": "string",
      "enum": [
        "default",
        "campaign",
        "premium"
      ],
      "description": "How the marble becomes selectable: default (from the start), campaign (granted by a campaign milestone), premium (granted only). Defaults to premium when premium is true, else default."
    },
    "appearance": {
      "type": "object",
      "description": "Visual appearance properties",
      "required": [
        "color"
      ],
      "properties": {
        "color": {
          "type": "object",
          "required": [
            "r",
            "g",
            "b"
          ],
          "properties": {
            "r": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "g": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "b": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "roughness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Surface roughness (0=smooth, 1=rough)"
        },
        "metallic": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Metallic factor"
        },
        "emissive": {
          "type": "object",
          "properties": {
            "r": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "g": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "b": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "intensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Multiplier: point-light intensity = intensity \u00d7 10000 (src/marbles/catalog-format.js EMISSIVE_LIGHT_SCALE)"
            }
          }
        },
        "texture": {
          "type": "string",
          "description": "Path to texture image (optional)"
        },
        "particleEffect": {
          "type": "string",
          "description": "Particle effect identifier (optional)"
        },
        "reflectance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "clearCoat": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "clearCoatRoughness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "thickness": {
          "type": "number",
          "minimum": 0,
          "description": "Glass thickness (refraction)"
        },
        "materialType": {
          "type": "string",
          "description": "Material preset name (src/marble-material-tier.js)"
        },
        "geometry": {
          "type": "string",
          "enum": [
            "sphere",
            "cube"
          ]
        },
        "rainbow": {
          "type": "boolean",
          "description": "Cycle hue over time"
        },
        "shader": {
          "type": "object",
          "description": "Per-marble procedural shader parameters (catalog-format.js SHADER_FIELDS)",
          "properties": {
            "bumpScale": {
              "type": "number"
            },
            "bumpFrequency": {
              "type": "number"
            },
            "grainScale": {
              "type": "number"
            },
            "scratchesIntensity": {
              "type": "number"
            },
            "anisotropy": {
              "type": "number"
            },
            "heatIntensity": {
              "type": "number"
            },
            "crackGlow": {
              "type": "number"
            },
            "iridescenceScale": {
              "type": "number"
            },
            "sparkleDensity": {
              "type": "number"
            },
            "fresnelStrength": {
              "type": "number"
            },
            "chromaticDispersion": {
              "type": "number"
            }
          }
        }
      }
    },
    "physics": {
      "type": "object",
      "description": "Physical properties",
      "properties": {
        "radius": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 3.0,
          "description": "Marble radius in meters"
        },
        "density": {
          "type": "number",
          "minimum": 0.01,
          "description": "Material density (affects mass)"
        },
        "friction": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "description": "Surface friction (above 1 = sticky)"
        },
        "restitution": {
          "type": "number",
          "minimum": 0,
          "maximum": 1.5,
          "description": "Bounciness. Must be <= 1.0 unless the marble is listed in assets/marbles/_bouncy-cap.json (hard max 1.5)."
        },
        "linearDamping": {
          "type": "number",
          "minimum": 0,
          "description": "Linear velocity damping"
        },
        "angularDamping": {
          "type": "number",
          "minimum": 0,
          "description": "Angular velocity damping"
        },
        "gravityScale": {
          "type": "number",
          "minimum": -2,
          "maximum": 5,
          "description": "Gravity multiplier (negative floats upward)"
        }
      }
    },
    "audio": {
      "type": "object",
      "description": "Custom audio properties",
      "properties": {
        "rollSound": {
          "type": "string",
          "description": "Custom rolling sound identifier"
        },
        "collisionSound": {
          "type": "string",
          "description": "Custom collision sound identifier"
        },
        "pitchVariation": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Random pitch variation amount"
        }
      }
    },
    "abilities": {
      "type": "object",
      "description": "Special abilities (optional)",
      "properties": {
        "doubleJump": {
          "type": "boolean"
        },
        "magnetic": {
          "type": "boolean"
        },
        "ghostMode": {
          "type": "boolean"
        },
        "speedBoost": {
          "type": "number"
        }
      }
    }
  }
}
